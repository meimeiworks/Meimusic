<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://android.com"
    android:id="@+id/mainRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="#F5F5F7">

    <!-- Верхняя панель: статус MEI ID и кнопка настроек -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="20dp">

        <TextView
            android:id="@+id/tvMainHeader"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Meimusic • Войдите в MEI ID"
            android:textSize="15sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnOpenSettings"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Настройки" />
    </LinearLayout>

    <!-- Блок скачивания музыки по ссылке -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Скачать трек в медиатеку:"
        android:textStyle="bold"
        android:layout_marginBottom="6dp" />

    <EditText
        android:id="@+id/etTrackUrl"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Вставьте прямую ссылку на MP3"
        android:inputType="textUri"
        android:layout_marginBottom="8dp" />

    <Button
        android:id="@+id/btnDownloadTrack"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Скачать MP3 на телефон"
        android:layout_marginBottom="24dp" />

    <!-- Центральная зона плеера -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Meimusic Alpha 0.1"
            android:textSize="26sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/tvCurrentThemeLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Тема: Мей Классик"
            android:textSize="14sp"
            android:layout_marginBottom="24dp" />

        <Button
            android:id="@+id/btnMeiMeiAction"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Мей Мей • Слушать" />

    </LinearLayout>

</LinearLayout>
